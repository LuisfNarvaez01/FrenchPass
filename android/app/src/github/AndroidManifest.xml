<!-- GitHub build only: the in-app updater (lib/core/services/update_service.dart).
     Google Play forbids apps that install their own updates, so none of this
     is in the Play build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lets the app offer the "install unknown apps" toggle and hand the
         downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Exposes the cache dir so the system installer can read the APK
             UpdateService downloads, via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
