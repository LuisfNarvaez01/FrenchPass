<?xml version="1.0" encoding="utf-8"?>
<!-- While the word is playing: a halo ring around the gold disc. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval"><solid android:color="@color/widget_ring_dark" /></shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval"><solid android:color="@color/widget_gold_dark" /></shape>
    </item>
</layer-list>
