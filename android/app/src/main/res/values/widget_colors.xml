<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget palette, hand-copied from AppPalette (lib/core/theme/
     app_palette.dart). RemoteViews cannot read the Dart theme, so keep the two
     in sync. The unsuffixed names follow the system (values-night overrides
     them); the _light/_dark ones are applied from Kotlin when the learner
     picked a fixed theme in the app. -->
<resources>
    <color name="widget_bg_start_light">#FFFDF8</color>
    <color name="widget_bg_end_light">#F5ECDD</color>
    <color name="widget_border_light">#E6DCCB</color>
    <color name="widget_frame_light">#7386601C</color>
    <color name="widget_gold_light">#86601C</color>
    <color name="widget_on_gold_light">#FFFFFF</color>
    <color name="widget_text_light">#2A231C</color>
    <color name="widget_text2_light">#5C5045</color>
    <color name="widget_muted_light">#74685A</color>
    <color name="widget_ring_light">#4086601C</color>
    <color name="widget_bg_start_dark">#1D2330</color>
    <color name="widget_bg_end_dark">#12161E</color>
    <color name="widget_border_dark">#2A3140</color>
    <color name="widget_frame_dark">#73D9AE55</color>
    <color name="widget_gold_dark">#D9AE55</color>
    <color name="widget_on_gold_dark">#17130B</color>
    <color name="widget_text_dark">#F4EFE6</color>
    <color name="widget_text2_dark">#BDB6AA</color>
    <color name="widget_muted_dark">#9A9489</color>
    <color name="widget_ring_dark">#40D9AE55</color>
    <color name="widget_bg_start">@color/widget_bg_start_light</color>
    <color name="widget_bg_end">@color/widget_bg_end_light</color>
    <color name="widget_border">@color/widget_border_light</color>
    <color name="widget_frame">@color/widget_frame_light</color>
    <color name="widget_gold">@color/widget_gold_light</color>
    <color name="widget_on_gold">@color/widget_on_gold_light</color>
    <color name="widget_text">@color/widget_text_light</color>
    <color name="widget_text2">@color/widget_text2_light</color>
    <color name="widget_muted">@color/widget_muted_light</color>
    <color name="widget_ring">@color/widget_ring_light</color>
</resources>
