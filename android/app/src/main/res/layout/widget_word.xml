<?xml version="1.0" encoding="utf-8"?>
<!-- Word of the day, framed like a Paris shop sign: warm card, inner gold
     hairline, the mascot sticker peeking from the corner and a play button
     right beside the pronunciation. Colours resolve from @color/widget_*
     (system theme); WordOfTheDayWidgetProvider overrides them when the
     learner fixed the theme in the app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/widget_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="5dp"
        android:background="@drawable/widget_frame" />

    <ImageView
        android:id="@+id/widget_mascot"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="0dp"
        android:rotation="-6"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_mascot" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="64dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="4dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:text="MOT DU JOUR"
                android:textColor="@color/widget_gold"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.06"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="…"
            android:textColor="@color/widget_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_play"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_play_bg"
                android:contentDescription="Escuchar la palabra">

                <ImageView
                    android:id="@+id/widget_play_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_volume" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_ipa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="@color/widget_text2"
                android:textSize="15sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Alternates the meaning and the example sentence, so a glance at
             the home screen shows the word in use, not just its gloss. -->
        <ViewFlipper
            android:id="@+id/widget_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autoStart="true"
            android:flipInterval="6000"
            android:inAnimation="@anim/widget_flip_in"
            android:outAnimation="@anim/widget_flip_out">

            <TextView
                android:id="@+id/widget_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/widget_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_example"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="2"
                android:textColor="@color/widget_text2"
                android:textSize="13sp"
                android:textStyle="italic" />
        </ViewFlipper>
    </LinearLayout>
</FrameLayout>
